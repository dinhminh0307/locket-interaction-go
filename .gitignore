-go/.gitignore
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove if you need to vendor)
vendor/

# Go workspace file
go.work

# Compiled binaries
locketcli
locket-server

#env
.env